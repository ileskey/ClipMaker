<Window x:Class="ClipDownloader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipDownloader" Width="760" Height="530" MinWidth="540" MinHeight="400">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="ClipDownloader" FontSize="28" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,12,0,20">
            <TextBlock Text="{Binding InitializationStatus}" TextWrapping="Wrap" />
            <TextBlock Text="파일 발견 여부만 확인합니다. 실행 가능 여부와 버전은 아직 확인하지 않습니다."
                       Foreground="DimGray" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ToolDiagnostics}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding ToolName}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StatusText}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding Detail}" Foreground="DimGray" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Button Grid.Row="3" Content="도구 다시 확인" Command="{Binding RefreshToolsCommand}"
                HorizontalAlignment="Right" Padding="18,8" Margin="0,12,0,0" />
    </Grid>
</Window>
