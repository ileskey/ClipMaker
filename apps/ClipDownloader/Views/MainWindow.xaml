<Window x:Class="ClipDownloader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipDownloader" Width="900" Height="850" MinWidth="620" MinHeight="480">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style TargetType="Button"><Setter Property="Padding" Value="14,7" /><Setter Property="Margin" Value="0,0,8,8" /></Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="ClipDownloader" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16" />
            <Label Content="영상 _URL" Target="{Binding ElementName=UrlInput}" />
            <TextBox x:Name="UrlInput" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="영상 URL" AutomationProperties.AutomationId="Url" />
            <Button Content="영상 불러오기" Command="{Binding LoadMetadataCommand}" HorizontalAlignment="Left" Margin="0,8,0,8" AutomationProperties.AutomationId="LoadMetadata" />
            <GroupBox Header="영상 정보" Margin="0,0,0,12" Padding="8">
                <StackPanel>
                    <Border Width="240" Height="135" HorizontalAlignment="Left" Background="#EEEEEE">
                        <TextBlock Text="{Binding ThumbnailStatus}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="썸네일" AutomationProperties.AutomationId="ThumbnailPlaceholder" />
                    </Border>
                    <TextBlock Text="제목" Margin="0,8,0,0" />
                    <TextBox Text="{Binding MetadataPresentation.Title, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="제목" AutomationProperties.AutomationId="MetadataTitle" />
                    <TextBlock Text="업로더 / 채널" />
                    <TextBox Text="{Binding MetadataPresentation.Uploader, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="75" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="업로더 / 채널" AutomationProperties.AutomationId="MetadataUploader" />
                    <TextBlock Text="총 길이" />
                    <TextBox Text="{Binding MetadataPresentation.Duration, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="총 길이" AutomationProperties.AutomationId="MetadataDuration" />
                    <TextBlock Text="선택 포맷 FPS" />
                    <TextBox Text="{Binding MetadataPresentation.FrameRate, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="선택 포맷 FPS" AutomationProperties.AutomationId="MetadataFps" />
                    <TextBlock Text="제공 해상도 (metadata 선언)" />
                    <TextBox Text="{Binding MetadataPresentation.Resolutions, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="제공 해상도 (metadata 선언)" AutomationProperties.AutomationId="MetadataResolutions" />
                    <Expander Header="정보 확인 사항"><TextBox Text="{Binding MetadataPresentation.Issues, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="정보 확인 사항" AutomationProperties.AutomationId="MetadataIssues" /></Expander>
                    <TextBlock Text="영상 불러오기로 재조회하면 시간과 Quality가 초기화됩니다." TextWrapping="Wrap" Foreground="DimGray" />
                </StackPanel>
            </GroupBox>
            <TextBlock Text="타임코드 HH:MM:SS:FF · 시계 시간 + FF/FPS · [Start, End)" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,6" IsEnabled="{Binding CanEdit}">
<TextBlock Text="Start" Width="65" VerticalAlignment="Center" />
<TextBox Width="62" Margin="0,0,8,0" Text="{Binding Start.Hours, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.AutomationId="StartHours" AutomationProperties.Name="Start HH" AutomationProperties.HelpText="Start 타임코드 HH" Tag="Hours" LostFocus="TimeFieldLostFocus" />
<TextBox Width="62" Margin="0,0,8,0" Text="{Binding Start.Minutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.AutomationId="StartMinutes" AutomationProperties.Name="Start MM" AutomationProperties.HelpText="Start 타임코드 MM" Tag="Minutes" LostFocus="TimeFieldLostFocus" />
<TextBox Width="62" Margin="0,0,8,0" Text="{Binding Start.Seconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.AutomationId="StartSeconds" AutomationProperties.Name="Start SS" AutomationProperties.HelpText="Start 타임코드 SS" Tag="Seconds" LostFocus="TimeFieldLostFocus" />
<TextBox Width="62" Margin="0,0,8,0" Text="{Binding Start.Frames, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.AutomationId="StartFrames" AutomationProperties.Name="Start FF" AutomationProperties.HelpText="Start 타임코드 FF" Tag="Frames" LostFocus="TimeFieldLostFocus" />
</StackPanel>
<StackPanel Orientation="Horizontal" Margin="0,6,0,6" IsEnabled="{Binding CanEdit}">
<TextBlock Text="End" Width="65" VerticalAlignment="Center" />
<TextBox Width="62" Margin="0,0,8,0" Text="{Binding End.Hours, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.AutomationId="EndHours" AutomationProperties.Name="End HH" AutomationProperties.HelpText="End 타임코드 HH" Tag="Hours" LostFocus="TimeFieldLostFocus" />
<TextBox Width="62" Margin="0,0,8,0" Text="{Binding End.Minutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.AutomationId="EndMinutes" AutomationProperties.Name="End MM" AutomationProperties.HelpText="End 타임코드 MM" Tag="Minutes" LostFocus="TimeFieldLostFocus" />
<TextBox Width="62" Margin="0,0,8,0" Text="{Binding End.Seconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.AutomationId="EndSeconds" AutomationProperties.Name="End SS" AutomationProperties.HelpText="End 타임코드 SS" Tag="Seconds" LostFocus="TimeFieldLostFocus" />
<TextBox Width="62" Margin="0,0,8,0" Text="{Binding End.Frames, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" AutomationProperties.AutomationId="EndFrames" AutomationProperties.Name="End FF" AutomationProperties.HelpText="End 타임코드 FF" Tag="Frames" LostFocus="TimeFieldLostFocus" />
</StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,8" IsEnabled="{Binding CanEdit}">
                <Label Content="_Quality" Target="{Binding ElementName=QualityInput}" />
                <ComboBox x:Name="QualityInput" Width="130" ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}" AutomationProperties.Name="Quality" AutomationProperties.AutomationId="Quality">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Height, StringFormat={}{0}p}" /><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Best"><Setter Property="Text" Value="Best" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Label Content="_Mode" Target="{Binding ElementName=ModeInput}" Margin="16,0,0,0" />
                <ComboBox x:Name="ModeInput" Width="130" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="Mode" AutomationProperties.AutomationId="Mode" />
            </StackPanel>
            <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" />
            <TextBlock Text="Fast는 실제 경계가 달라질 수 있습니다. Accurate는 원본 시작 참조와 획득 예산의 제한을 받습니다. 화질·모드를 자동 변경하지 않습니다." Foreground="DimGray" TextWrapping="Wrap" Margin="0,6,0,8" />
            <Label Content="MP4 출력 절대 경로 (_O)" Target="{Binding ElementName=OutputInput}" />
            <DockPanel>
                <Button Content="찾아보기" Command="{Binding BrowseOutputCommand}" DockPanel.Dock="Right" AutomationProperties.AutomationId="BrowseOutput" />
                <TextBox x:Name="OutputInput" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="MP4 출력 절대 경로" AutomationProperties.AutomationId="OutputPath" />
            </DockPanel>
            <TextBox x:Name="ErrorSummary" Text="{Binding ValidationSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Foreground="#A02020" AutomationProperties.Name="입력 오류 요약" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Margin="0,8,0,0">
                <Button Content="다운로드 (준비)" Command="{Binding PrepareCommand}" AutomationProperties.AutomationId="Prepare" />
                <Button Content="취소" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="CancelJob" />
            </WrapPanel>
            <Border Padding="14" BorderBrush="#AAAAAA" BorderThickness="1" Margin="0,0,0,10" Visibility="{Binding ShowingConfirmation, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock x:Name="ConfirmationHeading" Text="실행 전 확인" FontSize="18" FontWeight="SemiBold" Focusable="True" />
                    <TextBox Text="{Binding ConfirmationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="320" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="준비 요약" AutomationProperties.AutomationId="Confirmation" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="위 설정으로 실행" Command="{Binding ConfirmExecuteCommand}" IsDefault="False" AutomationProperties.AutomationId="ConfirmExecute" />
                        <Button Content="돌아가기" Command="{Binding BackCommand}" AutomationProperties.AutomationId="Back" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" TextWrapping="Wrap" FontWeight="SemiBold" Focusable="True" AutomationProperties.AutomationId="Status" AutomationProperties.LiveSetting="Polite" />
            <TextBox Text="{Binding OperationDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" AutomationProperties.Name="작업 진단 · 복사 가능" />
            <ProgressBar Height="10" Margin="0,8,0,8" IsIndeterminate="{Binding ProgressIndeterminate}" Value="{Binding ProgressPercent}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="현재 단계 진행률" />
            <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" />
            <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="350" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8" AutomationProperties.Name="최종 작업 결과 · 복사 가능" AutomationProperties.AutomationId="Result" />
            <Button Content="경고 확인 후 종료" Click="AcknowledgeClose" HorizontalAlignment="Left" Visibility="{Binding CanAcknowledgeClose, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="AcknowledgeClose" />
            <TextBox Text="{Binding ResourceWarnings, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" AutomationProperties.Name="미해결 자원 경고 · 복사 가능" />
            <Expander Header="도구 상태 · 파일 발견 검사" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding InitializationStatus}" TextWrapping="Wrap" />
                    <TextBlock Text="파일 발견과 실행 가능성은 다릅니다. 실제 호출 시 실행 진단을 수행합니다." TextWrapping="Wrap" Foreground="DimGray" />
                    <ItemsControl ItemsSource="{Binding ToolDiagnostics}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6,0,6"><TextBlock Text="{Binding ToolName}" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusText}" /><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Button Content="도구 다시 확인" Command="{Binding RefreshToolsCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Window>
